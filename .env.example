## База данных (PostgreSQL). Для Neon/Supabase возьмите прямую строку подключения.
DATABASE_URL=postgresql://user:password@localhost:5432/adam?sslmode=prefer

## Подпись сессий. Обязательно задайте длинную случайную строку в продакшене.
AUTH_SECRET=

## Пароль для входа тестовых пользователей (логин = id пользователя из seed). В продакшене без него вход закрыт.
TEST_PASSWORD=

## Защита служебных адресов (нужны, если вызываете /api/cron/* и синхронизацию)
CRON_SECRET=
SYNC_SECRET=
